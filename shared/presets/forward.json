{
  "using": [
    "urn:ietf:params:jmap:core",
    "urn:ietf:params:jmap:mail",
    "urn:ietf:params:jmap:submission"
  ],
  "methodCalls": [
    [
      "Email/set",
      {
        "accountId": "$ACCOUNT_ID",
        "create": {
          "d1": {
            "mailboxIds": {
              "$SENT_MAILBOX_ID": true
            },
            "from": [
              {
                "email": "$INBOX"
              }
            ],
            "to": [
              {
                "email": "$TO"
              }
            ],
            "subject": "$FORWARD_SUBJECT",
            "textBody": [
              {
                "partId": "b",
                "type": "text/plain"
              }
            ],
            "bodyValues": {
              "b": {
                "value": "$BODY\n\n$FORWARD_TEXT"
              }
            },
            "attachments": [
              {
                "blobId": "$FORWARD_BLOB_ID",
                "type": "message/rfc822",
                "name": "$FORWARD_NAME"
              }
            ],
            "keywords": {
              "$draft": true,
              "$seen": true
            }
          }
        }
      },
      "c0"
    ],
    [
      "EmailSubmission/set",
      {
        "accountId": "$ACCOUNT_ID",
        "onSuccessUpdateEmail": {
          "#s1": {
            "keywords/$draft": null,
            "keywords/$sent": true
          }
        },
        "create": {
          "s1": {
            "emailId": "#d1",
            "envelope": {
              "mailFrom": {
                "email": "$INBOX"
              },
              "rcptTo": [
                {
                  "email": "$TO"
                }
              ]
            }
          }
        }
      },
      "c1"
    ]
  ]
}
